# ====================================
# DATABASE CONFIGURATION
# ====================================
DB_NAME=ai_idea_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=postgres
DB_PORT=5432

# Prisma Database URL (use 'postgres' as host when running with Docker)
DATABASE_URL="postgresql://postgres:your_password_here@postgres:5432/ai_idea_db?schema=public"

# ====================================
# SERVER CONFIGURATION
# ====================================
PORT=3000
NODE_ENV=development

# ====================================
# JWT AUTHENTICATION
# ====================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ====================================
# COOKIE SETTINGS
# ====================================
COOKIE_NAME="rt"
COOKIE_SECURE=false

# ====================================
# GOOGLE OAUTH (Optional)
# ====================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# ====================================
# GITHUB OAUTH (Optional)
# ====================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# ====================================
# FRONTEND REDIRECT
# ====================================
FRONTEND_REDIRECT_URL="vscode://ui-gen-ai.ui-gen-ai/auth-callback"

# ====================================
# AI PROVIDERS (Optional - configure as needed)
# ====================================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com
TROLLLLM_API_KEY=your_trollllm_api_key

# ====================================
# WORKSPACE
# ====================================
WORKSPACE_ROOT=/tmp/workspaces
